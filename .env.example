# Application
APP_URL=http://localhost:3000

# Database (Supabase Postgres connection string with pgbouncer + direct)
# Format: postgresql://postgres.<project>:<password>@<host>:6543/postgres?pgbouncer=true
DATABASE_URL=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com → API Keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# MercadoPago (https://www.mercadopago.com.ar/developers)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Cron (random long string; required by /api/cron/* endpoints)
CRON_SECRET=

# MCP surcodia-payments (mcp/payments/README.md)
# Token de /api/mcp, 32 caracteres o más. Vacío = /api/mcp cerrado (503).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=
# Opcional: conexión con el rol de sólo lectura. Vacío = usa DATABASE_URL.
MCP_DATABASE_URL=
# Opcional: base de los links que devuelve el MCP. Vacío = usa APP_URL.
MCP_APP_URL=
