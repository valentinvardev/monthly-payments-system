# Application
APP_URL=http://localhost:3000

# Database (Supabase Postgres connection string with pgbouncer + direct)
# Format: postgresql://postgres.<project>:<password>@<host>:6543/postgres?pgbouncer=true
DATABASE_URL=

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com → API Keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# MercadoPago (https://www.mercadopago.com.ar/developers)
# CLIENT_ID/SECRET son los de la aplicación: habilitan el botón "conectar
# cuenta" del panel y el de /test. Cada redirect URI se carga en la app.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Cron (random long string; required by /api/cron/* endpoints)
CRON_SECRET=
