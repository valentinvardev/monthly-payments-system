// Payment system schema
// Amounts are stored in USD (source of truth). ARS is derived via ExchangeRate.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CLIENT
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PENDING_REVIEW
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  MERCADOPAGO
  BANK_TRANSFER
  CRYPTO
}

enum PaymentStatus {
  INITIATED
  PENDING_REVIEW
  CONFIRMED
  REJECTED
  REFUNDED
}

enum PaymentMethodKind {
  BANK_ACCOUNT
  CRYPTO_WALLET
}

enum PlanFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum EmailKind {
  INVOICE_CREATED
  REMINDER_BEFORE_DUE
  OVERDUE
  PAYMENT_RECEIVED
  PAYMENT_REVIEW_REQUIRED
  WELCOME
  MAGIC_LINK_INFO
  PROJECT_LEAD
  QUOTE_SENT
  QUOTE_DECIDED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  ARCHIVED
  CONVERTED
}

model User {
  id          String                 @id @default(cuid())
  authUserId  String                 @unique
  email       String                 @unique
  fullName    String?
  role        UserRole               @default(CLIENT)
  client      Client?
  mercadoPago MercadoPagoConnection?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([role])
}

model MercadoPagoConnection {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String    @unique
  mpUserId     String
  mpEmail      String?
  mpNickname   String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Client {
  id            String         @id @default(cuid())
  user          User?          @relation(fields: [userId], references: [id])
  userId        String?        @unique
  fullName      String
  email         String         @unique
  phone         String?
  taxId         String?
  notes         String?
  active        Boolean        @default(true)
  recurringPlan RecurringPlan?
  invoices      Invoice[]
  invites       Invite[]
  quotes        Quote[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([active])
  @@index([email])
}

model Invite {
  id        String    @id @default(cuid())
  token     String    @unique
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([clientId, usedAt])
}

model RecurringPlan {
  id          String        @id @default(cuid())
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String        @unique
  amountUsd   Decimal       @db.Decimal(12, 2)
  description String
  frequency   PlanFrequency @default(MONTHLY)
  anchorDate  DateTime
  active      Boolean       @default(true)
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([active])
}

model Invoice {
  id                String        @id @default(cuid())
  client            Client        @relation(fields: [clientId], references: [id])
  clientId          String
  amountUsd         Decimal       @db.Decimal(12, 2)
  description       String
  periodStart       DateTime
  periodEnd         DateTime
  dueDate           DateTime
  status            InvoiceStatus @default(PENDING)
  paidAt            DateTime?
  arsAmountSnapshot Decimal?      @db.Decimal(14, 2)
  arsRateSnapshot   Decimal?      @db.Decimal(14, 4)
  arsSnapshotAt     DateTime?
  payments          Payment[]
  emailLogs         EmailLog[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([clientId, dueDate])
  @@index([status, dueDate])
}

model Payment {
  id                String        @id @default(cuid())
  invoice           Invoice       @relation(fields: [invoiceId], references: [id])
  invoiceId         String
  method            PaymentMethod
  status            PaymentStatus @default(INITIATED)
  amountUsd         Decimal       @db.Decimal(12, 2)
  arsAmount         Decimal?      @db.Decimal(14, 2)
  arsRate           Decimal?      @db.Decimal(14, 4)
  externalId        String?
  externalRaw       Json?
  proofUrl          String?
  notes             String?
  confirmedAt       DateTime?
  confirmedByUserId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([invoiceId])
  @@index([method, status])
  @@index([externalId])
}

model PaymentMethodConfig {
  id           String            @id @default(cuid())
  kind         PaymentMethodKind
  label        String
  details      Json
  instructions String?
  active       Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([kind, active])
}

model EmailLog {
  id         String    @id @default(cuid())
  kind       EmailKind
  toEmail    String
  subject    String
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])
  invoiceId  String?
  providerId String?
  error      String?
  sentAt     DateTime  @default(now())

  @@index([toEmail])
  @@index([invoiceId])
  @@index([kind, sentAt])
}

// Ícono generado con Gemini desde /dashboard/icons. El PNG vive en el
// bucket público "generated-icons" de Supabase Storage; acá queda el
// prompt usado para poder reproducir el estilo.
model GeneratedIcon {
  id        String   @id @default(cuid())
  label     String
  prompt    String
  path      String
  url       String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  source    String
  pair      String
  rate      Decimal  @db.Decimal(14, 4)
  fetchedAt DateTime @default(now())

  @@index([source, pair, fetchedAt])
}

// Lead del formulario público "Contanos tu proyecto" (/contanos).
// Los campos de selección guardan slugs estables (no labels traducidos)
// para poder filtrar/reportar sin importar el idioma del visitante.
model ProjectLead {
  id           String     @id @default(cuid())
  name         String
  email        String
  company      String?
  niche        String // fotografia | ecommerce | ia | otro
  projectType  String // nuevo | tienda | sistema | automatizacion | mejora
  currentState String // nada | redes | sitio | sistema
  currentUrl   String?
  problem      String
  budgetRange  String // lt500 | 500-1500 | 1500-5000 | gt5000 | nose
  urgency      String // ya | mes | trimestre | explorando
  locale       String     @default("es")
  status       LeadStatus @default(NEW)
  notes        String?
  quotes       Quote[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, createdAt])
}

// Presupuesto para cliente existente o prospecto. Los datos del
// destinatario van denormalizados (name/email) para poder presupuestar
// a alguien que todavía no es Client. `token` es el acceso público:
// /presupuesto/[token], sin login.
model Quote {
  id           String       @id @default(cuid())
  token        String       @unique @default(cuid())
  client       Client?      @relation(fields: [clientId], references: [id])
  clientId     String?
  lead         ProjectLead? @relation(fields: [leadId], references: [id])
  leadId       String?
  name         String
  email        String
  company      String?
  title        String
  intro        String?
  locale       String       @default("es")
  validUntil   DateTime?
  status       QuoteStatus  @default(DRAFT)
  sentAt       DateTime?
  decidedAt    DateTime?
  rejectReason String?
  items        QuoteItem[]
  attachments  QuoteAttachment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])
}

model QuoteItem {
  id        String  @id @default(cuid())
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId   String
  label     String
  detail    String?
  amountUsd Decimal @db.Decimal(12, 2)
  sortOrder Int     @default(0)

  @@index([quoteId, sortOrder])
}

// PDFs que acompañan al presupuesto: el plan de trabajo, un anexo
// técnico, la propuesta larga. Viven en un bucket PRIVADO de Storage;
// la fila guarda sólo la ruta y todo acceso pasa por una signed URL con
// TTL, así el link del presupuesto sigue siendo la única puerta.
// `sizeBytes` sirve para mostrar el peso antes de abrirlo — el límite
// real lo impone el bucket, no este número, que llega del cliente.
model QuoteAttachment {
  id        String   @id @default(cuid())
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId   String
  path      String
  filename  String
  sizeBytes Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([quoteId, sortOrder])
}

// ---------------------------------------------------------------
// Prospección saliente
//
// ProjectLead es entrante: alguien llenó /contanos y llega con problema,
// presupuesto y urgencia ya declarados, todos obligatorios. Esto es lo
// contrario: organizaciones que todavía no nos conocen, que calificamos
// ANTES de escribirles y de las que no sabemos nada de presupuesto.
// Meterlos en la misma tabla obligaría a volver nullable media
// ProjectLead y a que cada consulta entrante cargue columnas muertas.
//
// Los enums espejan las validaciones de la planilla de prospección para
// que la importación sea uno a uno y no haya que traducir a mano.
// ---------------------------------------------------------------

enum ProspectTri {
  SI
  NO
  NO_SE
}

enum ProspectStage {
  SIN_CONTACTAR
  CONTACTADO
  RESPONDIO
  LLAMADA_AGENDADA
  PROPUESTA_ENVIADA
  GANADO
  PERDIDO
  DESCARTADO
}

enum ProspectChannel {
  EMAIL
  INSTAGRAM_DM
  TELEFONO
  PRESENCIAL
  REFERIDO
}

enum ProspectActivityKind {
  NOTA
  CONTACTO
  RESPUESTA
  LLAMADA
  PROPUESTA
  CAMBIO_ESTADO
}

model Prospect {
  id        String  @id @default(cuid())
  name      String // Instituto / club / academia
  zone      String // CABA, GBA Norte, Córdoba…
  segment   String  @default("idiomas") // idiomas | futbol | danza | jardin | gimnasio | egresados
  email     String?
  instagram String?
  website   String?
  phone     String? // para la cola de wa.me
  priority  Int     @default(2) // 1 = CABA/GBA, se trabaja primero

  // El filtro de calificación: tres cosas y se contacta con tres de tres.
  usesMercadoPago ProspectTri @default(NO_SE)
  over100Students ProspectTri @default(NO_SE)
  chargesMonthly  ProspectTri @default(NO_SE)

  // «Califica» NO se guarda: se deriva de los tres campos de arriba, misma
  // razón por la que el estado de las cuotas tampoco se guarda. Si se
  // guardara, el panel podría terminar diciendo algo distinto del filtro.

  // Lo que se anota entrando a su web como si fuéramos un padre que quiere
  // inscribir a un hijo. Es la frase de apertura y lo que mueve la tasa
  // de respuesta; por eso es un campo propio y no una nota suelta.
  frictionNote String?

  stage       ProspectStage    @default(SIN_CONTACTAR)
  contactedAt DateTime?
  channel     ProspectChannel?
  followUpAt  DateTime? // un solo seguimiento, a los 4 días

  activities ProspectActivity[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([name, zone])
  @@index([stage, priority])
  @@index([priority, createdAt])
}

model ProspectActivity {
  id         String               @id @default(cuid())
  prospect   Prospect             @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String
  kind       ProspectActivityKind
  body       String?
  createdAt  DateTime             @default(now())

  @@index([prospectId, createdAt])
}
